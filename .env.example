# Runtime public identity. Change these and recreate the app; no asset rebuild required.
APP_PRODUCT_NAME=Codex Web
APP_TAGLINE=PERSONAL AI WORKSTATION
APP_ICON=bolt
APP_THEME=indigo
APP_LOGIN_HINT=登录你的私人 Agent 工作站
APP_PRIVACY_NOTE=任务与文件仅在你的本机处理
# Optional absolute root for paths not explicitly supplied by Compose.
APP_STATE_ROOT=
CODEX_WEB_PROJECT_NAME=host-project
HOST=127.0.0.1
PORT=37821
BASE_PATH=/codex-web
# Use a name other than `owner` if you may enable host-root or Remote Worker;
# `owner` is reserved for the host-root identity. The base-only profile may
# keep this example value.
APP_USERNAME=owner
APP_DISPLAY_NAME=Owner
APP_PASSWORD_HASH=replace-with-bcrypt-hash
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL_HOURS=336
# Include BASE_PATH here. Optional Worker/host transfers require the same HTTPS entry URL.
PUBLIC_BASE_URL=http://localhost:37821/codex-web
# Individual upload and per-user storage ceilings (bytes). Files at least 64 MiB use resumable uploads in the browser.
MAX_UPLOAD_FILE_BYTES=2147483648
MAX_STORED_BYTES_PER_USER=21474836480
MINIMUM_FREE_DISK_BYTES=2147483648
# Online reader v1 guardrails. These are independent from attachment quota.
READER_MAX_FILE_BYTES=104857600
READER_MAX_CONCURRENT_READS=5
READER_RANGE_MAX_BYTES=1048576
READER_RETENTION_DAYS=15
RESUMABLE_UPLOAD_CHUNK_BYTES=8388608
RESUMABLE_UPLOAD_EXPIRY_HOURS=72
# Keep the real key only in the server-side app.env file. Never commit it.
DASHSCOPE_API_KEY=
# Optional OpenAI-compatible transcription endpoint. Leave blank to disable voice.
DASHSCOPE_BASE_URL=
DASHSCOPE_ASR_MODEL=
# Approximate dynamic spelling/topic context budget. Audio tokens are separate.
TRANSCRIPTION_CONTEXT_TOKEN_BUDGET=2000
TRANSCRIPTION_CONTEXT_MAX_IMAGES=2
TRANSCRIPTION_CONTEXT_MAX_IMAGE_BYTES=2097152
# New tasks prefer Astra/high where supported; saved task choices are preserved.
CODEX_MODEL=
CODEX_WINDOWS_SANDBOX=elevated
PYTHON_VERSION=3.12
PYTHON_RUNTIME_ROOT=

# Optional memory extractor. api requires key + HTTPS URL + model; codex-cli uses executor auth.
PERSONAL_MEMORY_PROVIDER=api
PERSONAL_MEMORY_EFFORT=medium
PERSONAL_MEMORY_API_KEY=
PERSONAL_MEMORY_BASE_URL=
PERSONAL_MEMORY_MODEL=

# Optional host/root bridge and Remote Worker enrollment. Empty means disabled.
# If the root bridge is selected, the app uses the container socket path
# /run/codex-web-host/host.sock; the host-side root service may need a different
# absolute path for the same bind-mounted socket. See docs/DEPLOYMENT_OPTIONS.md.
# Empty disables the host endpoint for node transfers and host-project skill operations.
CODEX_WEB_HOST_SOCKET_PATH=
CODEX_WEB_HOST_TENANT_ROOT=
CODEX_WEB_KNOWLEDGE_ROOT=
CODEX_WEB_HOST_HOME=
# Absolute Python executable when configured; otherwise optional host tasks use python3.
CODEX_WEB_SPREADSHEET_PYTHON=
CODEX_WEB_CODEX_HOME=
# Server-only opt-in/bootstrap value; devices receive independent grants.
# Existing shared-token Workers require the documented expiring migration.
# Clearing this value does not revoke issued device credentials.
REMOTE_WORKER_ENROLLMENT_TOKEN=
REMOTE_WORKER_RELEASE_ROOT=

# Optional encrypted cold storage. Configure every value together with your
# provider CLI and age keys; otherwise no archive/restore job should be run.
CODEX_WEB_COLD_STORAGE_CLI=
CODEX_WEB_COLD_STORAGE_DRIVE_ID=
CODEX_WEB_COLD_STORAGE_AGE_RECIPIENT=
CODEX_WEB_COLD_STORAGE_AGE_IDENTITY=

# Optional maintenance roots; use the same data/ and tenants/ as the app.
CODEX_WEB_STATE_ROOT=
# Manual archive limit only; maintain/--all process the finite eligible snapshot.
CWW_COLD_STORAGE_MAX_CONVERSATIONS=1
CWW_COLD_STORAGE_ISOLATION_GRACE_DAYS=7

# Account-private project boards start empty and are hidden until enabled in personal settings.
# This separate server switch closes the routes and retains all existing data.
CWW_PARA_ENABLED=true

# Default base image; choose documents explicitly when building for office tools.
# scripts/build-image.sh reads exported shell variables, not this Compose .env file.
# Raw Compose builds require WORKER_RELEASE_COMMIT=$(git rev-parse HEAD).
CODEX_WEB_IMAGE=codex-web:local
CODEX_WEB_BUILD_TARGET=runtime
CODEX_CLI_VERSION=0.162.1
# Empty selects the image's CLI; set the persistent current path only if managed separately.
CWW_CODEX_RUNTIME_PATH=

# Optional Gemini naming; empty keeps automatic Gemini titles disabled.
# Choose a model ID and effort from the authenticated node catalog.
CWW_ANTIGRAVITY_TITLE_MODEL=
CWW_ANTIGRAVITY_TITLE_EFFORT=

# Complete workflow admission: -1 is unlimited; positive integers impose a limit.
MAX_ACTIVE_WORKFLOWS=-1

# Continuous GPT-Live voice: independent from recorded speech and Codex login.
# Server-private key file; all required values must be supplied explicitly.
CODEX_WEB_LIVE_ENABLED=false
CODEX_WEB_LIVE_API_KEY_FILE=
CODEX_WEB_LIVE_ENDPOINT=
CODEX_WEB_LIVE_MODEL=
CODEX_WEB_LIVE_VOICE=marin
CODEX_WEB_LIVE_PROXY_URL=

# Optional host storage lifecycle. Full host settings: deploy/storage-lifecycle.env.example.
STORAGE_LIFECYCLE_ENABLED=0
STORAGE_HOST_DATA_ROOT=
# Optional host systemd memory guard. Base Compose/resource quotas remain enforced.
TASK_MEMORY_GUARD=false
CODEX_WEB_TASK_SCOPE_OWNER=
CODEX_WEB_TENANT_CONTAINER_NAME=

# Recorded speech provider; independent of continuous Live voice and Codex login.
TRANSCRIPTION_PROVIDER=dashscope
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_API_KEY=
OPENAI_TRANSCRIPTION_API_KEY_FILE=
OPENAI_TRANSCRIPTION_PROXY=direct
OPENAI_TRANSCRIPTION_LANGUAGES=
# Optional task-type -> model/effort JSON; empty policy uses the target node default.
CODEX_WEB_DOT_ROUTING_POLICY={}
