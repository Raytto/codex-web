HOST=127.0.0.1
PORT=37821
BASE_PATH=/codex-web
# Use a name other than `owner` if you may enable host-root or Remote Worker;
# `owner` is reserved for the host-root identity. The base-only profile may
# keep this example value.
APP_USERNAME=owner
APP_DISPLAY_NAME=Owner
APP_PASSWORD_HASH=replace-with-bcrypt-hash
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL_HOURS=336
PUBLIC_BASE_URL=http://localhost:37821/codex-web
# Individual upload and per-user storage ceilings (bytes). Files at least 64 MiB use resumable uploads in the browser.
MAX_UPLOAD_FILE_BYTES=2147483648
MAX_STORED_BYTES_PER_USER=21474836480
MINIMUM_FREE_DISK_BYTES=2147483648
# Online reader v1 guardrails. These are independent from attachment quota.
READER_MAX_FILE_BYTES=104857600
READER_MAX_CONCURRENT_READS=5
READER_RANGE_MAX_BYTES=1048576
READER_RETENTION_DAYS=15
RESUMABLE_UPLOAD_CHUNK_BYTES=8388608
RESUMABLE_UPLOAD_EXPIRY_HOURS=72
# Keep the real key only in the server-side app.env file. Never commit it.
DASHSCOPE_API_KEY=
# Optional OpenAI-compatible transcription endpoint. Leave blank to disable voice.
DASHSCOPE_BASE_URL=
DASHSCOPE_ASR_MODEL=transcription-model
# Approximate dynamic spelling/topic context budget. Audio tokens are separate.
TRANSCRIPTION_CONTEXT_TOKEN_BUDGET=500
TRANSCRIPTION_CONTEXT_MAX_IMAGES=2
TRANSCRIPTION_CONTEXT_MAX_IMAGE_BYTES=2097152
CODEX_MODEL=
CODEX_WINDOWS_SANDBOX=elevated
PYTHON_VERSION=3.12
PYTHON_RUNTIME_ROOT=

# Optional personal-memory extractor; both values are required.
PERSONAL_MEMORY_API_KEY=
PERSONAL_MEMORY_BASE_URL=
PERSONAL_MEMORY_MODEL=memory-model

# Optional host/root bridge and Remote Worker enrollment. Empty means disabled.
# If the root bridge is selected, the app uses the container socket path
# /run/codex-web-host/host.sock; the host-side root service may need a different
# absolute path for the same bind-mounted socket. See docs/DEPLOYMENT_OPTIONS.md.
CODEX_WEB_HOST_SOCKET_PATH=
CODEX_WEB_HOST_TENANT_ROOT=
CODEX_WEB_KNOWLEDGE_ROOT=
CODEX_WEB_CODEX_HOME=
REMOTE_WORKER_ENROLLMENT_TOKEN=
REMOTE_WORKER_RELEASE_ROOT=

# Optional encrypted cold storage. Configure every value together with your
# provider CLI and age keys; otherwise no archive/restore job should be run.
CODEX_WEB_COLD_STORAGE_CLI=
CODEX_WEB_COLD_STORAGE_DRIVE_ID=
CODEX_WEB_COLD_STORAGE_AGE_RECIPIENT=
CODEX_WEB_COLD_STORAGE_AGE_IDENTITY=
