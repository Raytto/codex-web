# Copy to an instance-owned 0600 file; supply all paths and identifiers.
# Keep each installation's state and cloud directory independent.
# Explicitly configure the owner's existing identity and matching recipient.
# No other instance's path is a default; do not generate a key per feature.
STORAGE_LIFECYCLE_ENABLED=0
STORAGE_INSTANCE_ID=
STORAGE_STATE_ROOT=
STORAGE_DATA_ROOT=
STORAGE_TENANT_ROOT=
STORAGE_HOST_CODEX_HOME=
STORAGE_HOST_USER_ID=
STORAGE_DATABASE_PATH=
# Use this instance's actual deployment gate and lock, shared with its publisher.
STORAGE_MAINTENANCE_GATE=
STORAGE_MAINTENANCE_LOCK=
STORAGE_LIFECYCLE_ROOT=
STORAGE_TRANSFER_ROOT=
STORAGE_ALIYUN_COMMAND=
STORAGE_ALIYUN_CONFIG=
STORAGE_TRANSFER_UID=
STORAGE_TRANSFER_GID=
STORAGE_DRIVE_ID=
STORAGE_REMOTE_ROOT=
STORAGE_AGE_RECIPIENT=
STORAGE_AGE_IDENTITY=
# The backup plan's keyRecovery is an external custodian label, never a secret
# or a cloud copy of the private key. Keep a host copy for automatic restores.
STORAGE_BACKUP_PLAN=
STORAGE_ENGINE_VERSION=
# Explicit old directories to import; omit only for a new installation.
STORAGE_LEGACY_REMOTE_ROOTS=
STORAGE_LEGACY_CONVERSATION_ISOLATION=
STORAGE_LEGACY_VOICE_ISOLATION=
STORAGE_LEGACY_READER_ISOLATION=
STORAGE_LEGACY_CONVERSATION_REMOTE_ROOT=
STORAGE_LEGACY_READER_REMOTE_ROOT=
STORAGE_SHARED_MEASURE_ROOTS=
# Optional instance-owned cache helper, root-owned and not group/world writable.
# It must accept gc-idle and select only this instance's dedicated builder.
STORAGE_BUILD_CLEANER=

# Background archive traffic only. Interactive user restores bypass pacing.
# One background object per 5-minute timer; yield while users are running/restoring.
STORAGE_BACKGROUND_REQUEST_INTERVAL_MS=1000
STORAGE_BACKGROUND_MAX_ITEMS=1
STORAGE_BACKGROUND_BUDGET_MS=120000
# Conservative mode archives/converts only; no whole-site backup, final purge,
# event deletion or database compaction. Activate with --activate-background-only.
STORAGE_MAINTENANCE_MODE=conservative
