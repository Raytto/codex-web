[Unit]
Description=Codex Web queue-aware self-publish coordinator
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=%i
WorkingDirectory=%h/codex-web
ExecStart=%h/codex-web/deploy/codex-web-rebuild-coordinator
TimeoutStartSec=infinity
UMask=0077
